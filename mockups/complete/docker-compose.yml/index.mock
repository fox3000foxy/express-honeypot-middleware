version: '3.8'
services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.prod
    image: registry.example.com/app:latest
    container_name: production_app
    restart: unless-stopped
    ports:
      - "443:443"
    env_file:
      - .env.production
    volumes:
      - ./storage/logs:/var/www/storage/logs
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    networks:
      - backend

  db:
    image: mysql:8.0.35
    container_name: production_db
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: production_app
      MYSQL_USER: app_service
      MYSQL_PASSWORD: aB3#dE5\$fG7*hJ9
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - backend

  redis:
    image: redis:7.2-alpine
    container_name: production_cache
    restart: unless-stopped
    command: redis-server --requirepass R3d!sK3y2025 --appendonly yes
    volumes:
      - redis_data:/data
    networks:
      - backend

volumes:
  db_data:
  redis_data:

networks:
  backend:
    driver: bridge