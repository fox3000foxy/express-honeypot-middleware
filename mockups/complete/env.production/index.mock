# Production Environment
NODE_ENV=production
PORT=443
API_URL=https://api.internal.example.com/v2
SENTRY_DSN=https://abc123def456@sentry.example.com/42
NEW_RELIC_LICENSE_KEY=NRAA-1234567890abcdef
