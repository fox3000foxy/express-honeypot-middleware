/* Main stylesheet v2.4.1 */
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#333;background:#f8f9fa;line-height:1.6}
.container{max-width:1200px;margin:0 auto;padding:0 20px}
header{background:#fff;box-shadow:0 2px 4px rgba(0,0,0,.1);padding:16px 0}
.btn{display:inline-block;padding:10px 20px;border-radius:6px;font-size:14px;cursor:pointer;transition:all .2s}
.btn-primary{background:#0066cc;color:#fff;border:none}
.btn-primary:hover{background:#0052a3}