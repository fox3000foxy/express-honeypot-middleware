{
  "apiVersion": "v1",
  "clusters": [
    {
      "name": "my-cluster",
      "cluster": {
        "server": "https://my-cluster.example.com",
        "certificate-authority": "/path/to/ca.crt"
      }
    }
  ],
  "contexts": [
    {
      "name": "my-context",
      "context": {
        "cluster": "my-cluster",
        "user": "my-user"
      }
    }
  ],
  "current-context": "my-context",
  "users": [
    {
      "name": "my-user",
      "user": {
        "client-certificate": "/path/to/client.crt",
        "client-key": "/path/to/client.key"
      }
    }
  ]
}